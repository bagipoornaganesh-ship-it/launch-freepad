rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid']) &&
             data.uid == request.auth.uid &&
             (data.get('email', '') is string && data.get('email', '').size() <= 200) &&
             (data.get('displayName', '') is string && data.get('displayName', '').size() <= 100);
    }

    // Clients
    match /users/{userId}/clients/{clientId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(clientId) && isValidClient(incoming());
      allow update: if isOwner(userId) && isValidClient(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'niche', 'status', 'contactInfo', 'leadSource', 'dateContacted', 'followUpDate', 'notes', 'paymentReceived', 'updatedAt'])
      );
      allow delete: if isOwner(userId);
    }

    function isValidClient(data) {
      return data.keys().hasAll(['id', 'name', 'status', 'userId']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.status in ['Cold', 'Contacted', 'Engaged', 'Secured', 'Replied', 'Closed'] &&
             data.userId == request.auth.uid &&
             (data.get('niche', '') is string && data.get('niche', '').size() <= 100) &&
             (data.get('contactInfo', '') is string && data.get('contactInfo', '').size() <= 200) &&
             (data.get('leadSource', '') is string && data.get('leadSource', '').size() <= 50) &&
             (data.get('notes', '') is string && data.get('notes', '').size() <= 2000) &&
             (data.get('paymentReceived', false) is bool);
    }

    // Transactions
    match /users/{userId}/transactions/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isOwner(userId) && isValidTransaction(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'amount', 'date', 'method', 'updatedAt'])
      );
      allow delete: if isOwner(userId);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'name', 'amount', 'date', 'userId']) &&
             data.id is string && data.id.size() <= 64 &&
             data.type in ['income', 'expense'] &&
             data.name is string && data.name.size() <= 200 &&
             data.amount is number &&
             data.date is string && data.date.size() <= 20 &&
             data.userId == request.auth.uid &&
             (data.get('method', '') is string && data.get('method', '').size() <= 50);
    }

    // Roadmap
    match /users/{userId}/roadmap/{dayId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(dayId) && isValidRoadmapDay(incoming());
      allow update: if isOwner(userId) && isValidRoadmapDay(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['tasks', 'updatedAt'])
      );
      allow delete: if isOwner(userId);
    }

    function isValidRoadmapDay(data) {
      return data.keys().hasAll(['day', 'tasks', 'userId']) &&
             data.day is number && data.day >= 1 && data.day <= 7 &&
             data.tasks is list && data.tasks.size() <= 20 &&
             data.userId == request.auth.uid;
    }
  }
}
